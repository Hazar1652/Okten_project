DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_PAGE_SIZE=20

POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_pass
# localhost — коли Django запускаєш на Windows (runserver). У Docker compose підставляє db.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Без Docker: USE_SQLITE=1 (файл db.sqlite3 у папці backend)
# USE_SQLITE=1

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1

# Google Cloud → Places API (New)
GOOGLE_PLACES_API_KEY=

# OAuth (окремо від Places API)
# Google: Credentials → OAuth 2.0 Client ID (Web) → Authorized JS origins: http://localhost:5173, http://localhost
GOOGLE_OAUTH_CLIENT_ID=
# Facebook: developers.facebook.com → App → Settings → Basic + Facebook Login product
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
